{
  "name": "extant-band",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "bot:setup": "node --env-file=.env scripts/setup-bot.mjs",
    "bot:deploy": "node scripts/prepare-functions.mjs && npx --yes netlify-cli@27.8.0 deploy --prod"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.3",
    "@img/sharp-linux-x64": "^0.35.4"
  }
}
